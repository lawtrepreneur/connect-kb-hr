# connect-kb-hr environment example
# Copy to .env and fill in real values.
# Database: legalx-mcp-pg container, hr_kb database (pgvector required)

# Admin DSN — needs superuser or CREATE SCHEMA/ROLE/EXTENSION privileges
CORPUS_HR_TEST_DSN=postgresql://<admin_user>:<password>@<host>:5435/hr_kb

# Publisher DSN — hr_publisher role, writes corpus data
CORPUS_HR_PUBLISHER_DSN=postgresql://hr_publisher_login:<password>@<host>:5435/hr_kb

# Audience-bound reader DSNs — read-only, audience-isolated
CORPUS_HR_EMPLOYER_DSN=postgresql://hr_employer_reader_login:<password>@<host>:5435/hr_kb
CORPUS_HR_EMPLOYEE_DSN=postgresql://hr_employee_reader_login:<password>@<host>:5435/hr_kb

# Policy runtime DSN — usage event writes only, no corpus chunk access
CORPUS_HR_POLICY_DSN=postgresql://hr_policy_runtime_login:<password>@<host>:5435/hr_kb
