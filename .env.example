# connect-kb-hr environment example
# Copy to .env and fill in real values.
# Unified corpus design: one hr_kb database, audience is an assignment predicate.

# Admin/migration DSN — superuser or CREATE SCHEMA/ROLE/EXTENSION privileges
CORPUS_HR_TEST_DSN=postgresql://<admin_user>:<password>@<host>:5435/hr_kb

# Publisher DSN — hr_publisher role, writes corpus data (kb schema)
CORPUS_HR_DSN=postgresql://hr_publisher_login:<password>@<host>:5435/hr_kb

# Runtime DSN — hr_runtime role, read-only corpus access
CORPUS_HR_RUNTIME_DSN=postgresql://hr_runtime_login:<password>@<host>:5435/hr_kb

# Policy writer DSN — hr_policy_writer role, content-free usage records
CORPUS_HR_POLICY_DSN=postgresql://hr_policy_writer_login:<password>@<host>:5435/hr_kb
