# connect-kb-hr environment
# Copy to .env and fill in real values

# Admin DSN — needs CREATE EXTENSION, CREATE SCHEMA, CREATE ROLE, DDL privileges
CORPUS_HR_TEST_DSN=postgresql://<admin_user>:<password>@<host>:5432/hr_kb

# Audience-bound reader DSNs — read-only, no corpus chunk write access
CORPUS_HR_EMPLOYER_DSN=postgresql://hr_employer_reader_login:<password>@<host>:5432/hr_kb
CORPUS_HR_EMPLOYEE_DSN=postgresql://hr_employee_reader_login:<password>@<host>:5432/hr_kb

# Policy runtime DSN — usage event writes only, no corpus chunk access
CORPUS_HR_POLICY_DSN=postgresql://hr_policy_runtime_login:<password>@<host>:5432/hr_kb
